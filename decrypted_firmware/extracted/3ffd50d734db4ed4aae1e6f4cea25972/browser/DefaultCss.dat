 ::-webkit-validation-bubble { opacity: 1; -webkit-user-select: none; } ::-webkit-validation-bubble-message { top: -5px; color: rgb(0, 0, 0); border: solid rgb(200, 200, 200) 1px; background: rgb(255, 255, 255); padding: 9px; border-radius: 2px; box-shadow: 0 0 5px rgba(0, 0, 0, 0.25); } ::-webkit-validation-bubble-heading { font-size: 13px; font-weight: normal; word-break: normal; } ::-webkit-validation-bubble-arrow { left: 32px; top: 2px; width: 15px; height: 15px; background: rgb(255, 255, 255); border: solid rgba(200, 200, 200, 1) 1px; border-width: 1px 0 0 1px; box-shadow: -2px -2px 2px rgba(0, 0, 0, 0.1); -webkit-transform-origin: 0 0; -webkit-transform: scaleX(0.85) rotate(45deg); } ::-webkit-validation-bubble-arrow-clipper { height: 18px; } 